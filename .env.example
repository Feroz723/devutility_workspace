# =====================================================================
# Autonomous Business OS - Environment Configuration
# =====================================================================
# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env.local` or any file containing real secrets.
# Only variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# Everything else is server-only and must never reach the client.
# =====================================================================

# ---------- Database ----------
# PostgreSQL connection string (also Supabase-compatible).
# Example: postgresql://user:password@host:5432/autonomous_business_os
DATABASE_URL=

# ---------- Supabase (optional, NOT_CONNECTED by default) ----------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------- AI providers (server-side only) ----------
# AI_PROVIDER selects the active provider.
# Allowed: "groq" | "gemini" | "mock"
AI_PROVIDER=mock
AI_MODEL=model-placeholder
AI_API_KEY=

# Groq
GROQ_API_KEY=

# Google Gemini
GEMINI_API_KEY=

# ---------- n8n automation ----------
# Base URL of your self-hosted n8n instance.
N8N_BASE_URL=
# Shared secret used to authenticate inbound webhooks FROM n8n.
N8N_WEBHOOK_SECRET=

# ---------- GitHub (server-side only) ----------
# Personal access token used by automation agents to push to repos.
GITHUB_TOKEN=

# ---------- Application ----------
NODE_ENV=development
APP_URL=http://localhost:3000
# Owner authentication token for sensitive endpoints (X-Owner-Token header)
OWNER_TOKEN=your_secure_owner_token_here

# ---------- Spending guardrails ----------
# Hard cap for AI-driven spending in paise (1 INR = 100 paise).
# MUST remain 0 in the current release. Enforced at runtime.
AUTONOMOUS_SPENDING_LIMIT_INR=0
# Require human approval for ANY paid, sensitive, or irreversible action.
REQUIRE_HUMAN_APPROVAL_FOR_EXTERNAL_ACTIONS=true