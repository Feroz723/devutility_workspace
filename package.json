{
  "name": "autonomous-business-os",
  "version": "0.1.0",
  "private": true,
  "description": "Autonomous digital business operating system with a hard zero-spend guardrail.",
  "scripts": {
    "dev": "node api.js && next dev",
    "build": "node api.js && next build",
    "start": "node api.js && next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "npx tsx database/migrate.ts",
    "seed": "npx tsx database/seed.ts",
    "worker": "npx tsx scripts/worker-daemon.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.45.4",
    "class-variance-authority": "0.7.0",
    "clsx": "2.1.1",
